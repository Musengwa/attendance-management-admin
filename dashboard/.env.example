# Copy to dashboard/.env and fill in. dashboard/.env is gitignored; never commit it.
# Real environment variables override anything set here.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Matcher service -> Django (must equal the matcher's DJANGO_API_TOKEN) ---
ATTENDANCE_API_TOKEN=dev-token-change-me

# --- Django -> embedding service ---
EMBED_URL=http://127.0.0.1:8000
EMBED_API_TOKEN=

# --- Blockchain ---
# JSON-RPC address of the node (local Ganache is http://127.0.0.1:7545)
CHAIN_RPC_URL=https://33wj9spz-8545.inc1.devtunnels.ms/
# Only needed if the dev tunnel port is private:
#   devtunnel token <tunnel-id> --scopes connect
CHAIN_TUNNEL_TOKEN=
# Seconds before an RPC call gives up
CHAIN_TIMEOUT=5
# Filled in once the Attendance contract is deployed
CONTRACT_ADDRESS=
# Defaults to ../blockchain/Attendance.abi.json (bare ABI list or Truffle/Hardhat artifact)
# CONTRACT_ABI_PATH=
